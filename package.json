{
  "name": "remotion-shorts-kit",
  "version": "0.1.0",
  "description": "Open-source Remotion starter kit for vertical 1080x1920 explainer shorts",
  "author": "Yusuf Berat Zengin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YusufBeratZengin/remotion-shorts-kit.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src"],
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:demo": "remotion render src/index.ts ThermosExplainer out/demo.mp4",
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.537",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@remotion/cli": "4.0.537",
    "@types/node": "20.17.19",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.7.3",
    "vitest": "3.0.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
